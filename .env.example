# Supabase（ログインに必須。Vite は VITE_ プレフィックスのみクライアントに渡す）
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 中継サーバー（本番は wss://）。未設定なら ws://localhost:8080/app
VITE_RELAY_URL=wss://kinyu-relay.onrender.com/app

# 研究員の受け答え（Gemini 3.5 Flash-Lite）。Google AI Studio で作った鍵。
# サーバー側（/api/chat）だけが使うので VITE_ を付けない。未設定なら定型文で答える。
GEMINI_API_KEY=
# 研究員の会話に使うモデル（未設定なら gemini-3.5-flash-lite）
GEMINI_CHAT_MODEL=

# AIリスク監督（/api/risk）。EA の新規注文を、買い／売り別に許可・停止する。
# モデルは既定 gemini-3.5-flash。勝手に Flash-Lite へは落とさない（変えたいときだけ書く）。
# ここが費用のほとんどを占める（1台あたり月およそ4千回。人数ぶん増える）。
# 参考: 100万トークンあたり  gemini-3.5-flash 入$1.50/出$9.00
#                            gemini-3.5-flash-lite 入$0.30/出$2.50
#                            deepseek-flash 入$0.15/出$0.60（協定時間帯は倍）
# 乗り換えるときは、まず「記録のみ（shadow）」で走らせて判定を見比べること。
GEMINI_RISK_MODEL=gemini-3.5-flash
# 見張りだけ別会社にしたいとき。RISK_PROVIDER=deepseek で切り替わる
# （鍵だけ置いても deepseek 側に倒れる）。どちらで判定したかは decision.model に残る。
RISK_PROVIDER=
DEEPSEEK_API_KEY=
# 未設定なら deepseek-flash。旧称 deepseek-chat は料金表・モデル一覧から消えているので使わない。
DEEPSEEK_RISK_MODEL=
# お客様のPCのブリッジだけが呼べるようにする合言葉。
# 空のあいだは /api/risk は 503 を返し、EA 側も「切」のままになる。
# bridge.env（%LOCALAPPDATA%\AITrader\bridge.env）の TRELAB_RISK_TOKEN と同じ文字列にする。
TRELAB_RISK_TOKEN=
