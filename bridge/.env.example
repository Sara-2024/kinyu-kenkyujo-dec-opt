# ── 接続先（トレラボのWebSocketサーバー） ───────────────────
# ローカル: ws://127.0.0.1:8080/bridge
# 本番(Render): wss://kinyu-relay.onrender.com/bridge
TRELAB_WS_URL=wss://kinyu-relay.onrender.com/bridge
TRELAB_TOKEN=ここにブリッジ用のアクセストークン
BRIDGE_ID=vps-01

# ── MT5 ─────────────────────────────────────────────────
# 起動中のターミナルに繋ぐだけなら PATH 以下は空でよい
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── EAが毎Tick読むグローバル変数 ────────────────────────────
GV_NAME=AI_TRADING_ALLOWED
GV_DEFAULT=1

# ── 再接続 ───────────────────────────────────────────────
RECONNECT_MIN_SEC=3
RECONNECT_MAX_SEC=60
PING_INTERVAL_SEC=20
PING_TIMEOUT_SEC=20

# ── 見張り ───────────────────────────────────────────────
WATCHDOG_INTERVAL_SEC=30
REASSERT_STATE=true
# 0 以外にすると、その秒数だけサーバーと切れたら自動で売買停止（デッドマンスイッチ）
FAILSAFE_DISCONNECT_SEC=0

# ── ログ ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bridge.log

# ── AIリスク監督（新規注文の許可・停止） ───────────────────
# 合言葉が空のあいだは動かない（Gemini の踏み台にしないため）。
# Vercel 側の環境変数 TRELAB_RISK_TOKEN と同じ文字列にする。
TRELAB_RISK_TOKEN=
RISK_API_URL=https://kinyu-kenkyujo-dec-opt.vercel.app/api/risk
RISK_GATE_ENABLED=true
# 評価の間隔（秒）。60=確定M1足ごと。人数が多いときは 300 などに伸ばす
RISK_EVAL_SEC=60
# 重要水準まで ATR 何個ぶんに近づいたら足の途中でも見直すか
RISK_NEAR_LEVEL_ATR=1.0
RISK_NEAR_RECHECK_SEC=30
# 停止を続ける最短時間（秒）と、再開に必要な「連続で問題なし」の回数
RISK_MIN_BLOCK_SEC=180
RISK_UNBLOCK_CONFIRM=2
# 口座種別ごとの初期の動き方。本番口座は shadow（記録のみ）から始める
RISK_DEMO_MODE=on
RISK_LIVE_MODE=shadow
# 銘柄を固定したいとき（空なら EA が使っている銘柄を自動で選ぶ）
RISK_SYMBOL=
