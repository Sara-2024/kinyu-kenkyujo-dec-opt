# ── 接続先（トレラボのWebSocketサーバー） ───────────────────
# ローカル: ws://127.0.0.1:8080/bridge
# 本番(Render): wss://kinyu-relay.onrender.com/bridge
TRELAB_WS_URL=wss://kinyu-relay.onrender.com/bridge
TRELAB_TOKEN=ここにブリッジ用のアクセストークン
BRIDGE_ID=vps-01

# ── MT5 ─────────────────────────────────────────────────
# 起動中のターミナルに繋ぐだけなら PATH 以下は空でよい
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── EAが毎Tick読むグローバル変数 ────────────────────────────
GV_NAME=AI_TRADING_ALLOWED
GV_DEFAULT=1

# ── 再接続 ───────────────────────────────────────────────
RECONNECT_MIN_SEC=3
RECONNECT_MAX_SEC=60
PING_INTERVAL_SEC=20
PING_TIMEOUT_SEC=20

# ── 見張り ───────────────────────────────────────────────
WATCHDOG_INTERVAL_SEC=30
REASSERT_STATE=true
# 0 以外にすると、その秒数だけサーバーと切れたら自動で売買停止（デッドマンスイッチ）
FAILSAFE_DISCONNECT_SEC=0

# ── ログ ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bridge.log
